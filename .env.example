# Copia este archivo a `.env` y rellena el valor real.
# `.env` está ignorado por Git: nunca subas una clave real al repositorio.

# GEMINI_API_KEY: clave de la API de Google Gemini.
# Se usa EXCLUSIVAMENTE en el servidor (server.ts). Nunca la expongas al
# navegador ni la publiques como variable VITE_*.
# Puedes generarla en https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
